{
  "name": "forgedock-pi",
  "version": "0.3.0",
  "description": "ForgeDock for Pi: /work-on and /orchestrate run the ForgeDock engine with every session on the Pi harness, any model",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "github",
    "forgedock",
    "orchestration"
  ],
  "author": "RapierCraft Studios",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RapierCraftStudios/forgedock-pi.git"
  },
  "homepage": "https://github.com/RapierCraftStudios/forgedock-pi#readme",
  "bugs": {
    "url": "https://github.com/RapierCraftStudios/forgedock-pi/issues"
  },
  "exports": {
    ".": "./src/extension.ts"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --json --ignore-scripts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
