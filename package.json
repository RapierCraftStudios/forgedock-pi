{
  "name": "forgedock-pi",
  "version": "0.2.0-candidate.1",
  "description": "Thin Pi-native ForgeDock issue owner, dispatcher, and independent review routes",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "github",
    "subagents",
    "forgedock",
    "code-review"
  ],
  "author": "RapierCraft Studios",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RapierCraftStudios/forgedock-pi.git"
  },
  "homepage": "https://github.com/RapierCraftStudios/forgedock-pi#readme",
  "bugs": {
    "url": "https://github.com/RapierCraftStudios/forgedock-pi/issues"
  },
  "exports": {
    ".": "./candidate/extension.ts"
  },
  "bin": {
    "forgedock-candidate": "./bin/forgedock-candidate.mjs"
  },
  "files": [
    "bin/",
    "candidate/",
    "scripts/doctor-candidate.sh",
    "scripts/install-candidate.sh",
    "scripts/launch-candidate.sh",
    "scripts/native-smoke.sh",
    "scripts/prepare-integration-checkout.sh",
    "scripts/replace-candidate.sh",
    "scripts/rollback-candidate.sh",
    "templates/forge.yaml",
    "docs/candidate.md",
    "docs/qualification-results.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --json --ignore-scripts"
  },
  "pi": {
    "extensions": [
      "./candidate/extension.ts"
    ],
    "prompts": [
      "./candidate/prompts"
    ],
    "skills": [
      "./candidate/skills"
    ],
    "subagents": {
      "agents": [
        "./candidate/agents"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "pi-subagents": "0.60.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "24.13.3",
    "pi-subagents": "0.60.0",
    "tsx": "4.23.12",
    "typebox": "1.3.18",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
