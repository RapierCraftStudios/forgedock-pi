{
  "schema": "forgedock.config/v1",
  "repository": {
    "provider": "github",
    "name": "owner/repository"
  },
  "state": {
    "branch": "forgedock/state/v1",
    "leaseSeconds": 3600,
    "heartbeatSeconds": 60
  },
  "branches": {
    "integration": ["staging", "milestone/*"],
    "protected": ["main"],
    "autoMergeIntegration": true
  },
  "verification": {
    "commands": {}
  },
  "review": {
    "required": ["forge-review-correctness", "forge-review-security"],
    "maxRounds": 3
  },
  "subagents": {
    "maxConcurrent": 2,
    "maxDepth": 2
  }
}
