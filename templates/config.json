{
  "schema": "forgedock.config/v1",
  "repository": {
    "provider": "github",
    "name": "owner/repository"
  },
  "state": {
    "branch": "forgedock/state/v1"
  },
  "branches": {
    "integration": ["staging", "milestone/*"],
    "protected": ["main"],
    "autoMergeIntegration": true
  },
  "verification": {
    "github": {
      "required": true,
      "requiredBranches": ["main"],
      "waitTimeoutMs": 1800000,
      "pollIntervalMs": 10000
    },
    "commands": {}
  },
  "review": {
    "required": ["forge-review-correctness", "forge-review-security"],
    "maxRounds": 4
  },
  "orchestration": {
    "maxConcurrent": 2,
    "maxIssues": 20
  },
  "subagents": {
    "maxConcurrent": 2,
    "maxDepth": 2,
    "workOnTimeoutMs": 14400000,
    "reviewerTimeoutMs": 1800000
  }
}
