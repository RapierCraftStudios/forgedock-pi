  "findings": [
    {
      "id": "api-001",
      "reviewer": "forge-review-api",
      "runId": "review-059b1992-ea2d-4d4f-9d39-8f5b117f2d5d",
      "headSha": "74e07982ef2312987c024715d41a631afdb4fdcc",
      "confidence": "confirmed",
      "severity": "medium",
      "category": "production-safety",
      "file": "src/workflows/work-on.ts",
      "line": 3867,
      "summary": "Awaiting-merge label is not rolled back when the resumed merge attempt fails",
      "evidence": [
        "The changed resume path calls #projectWorkflowStage(link, \"awaitingMerge\", ...) before invoking github.mergePullRequest.",
        "That github.mergePullRequest call has no catch invoking rollbackAwaitingMergeLabel, so a provider error leaves the issue labeled workflow:awaiting-merge even though the PR remains unmerged.",
        "The new rollback helper is only used by the separate earlier merge path, not this newly labeled resume path."
      ]
    },
    {
      "id": "forge-review-web-001",
      "reviewer": "forge-review-web",
      "runId": "review-059b1992-ea2d-4d4f-9d39-8f5b117f2d5d",
      "headSha": "74e07982ef2312987c024715d41a631afdb4fdcc",
      "confidence": "confirmed",
      "severity": "medium",
      "category": "production-safety",
      "file": "src/workflows/work-on.ts",
      "line": 3847,
      "summary": "Projects awaiting-merge before validating already-merged PR evidence",
      "evidence": [
        "The new #projectWorkflowStage(..., \"awaitingMerge\", ...) call runs before the durableMergeSha lookup and before the guard that throws when currentPull.merged is true but no durable merge-complete SHA exists.",
        "In that recovery state, the function throws after successfully updating the issue label, leaving a merged pull request projected as workflow:awaiting-merge until a later reconciliation succeeds; the prior flow did not introduce this update before the guard."
      ]
    },
    {
      "id": "deployment-001",
      "reviewer": "forge-review-deployment",
      "runId": "review-059b1992-ea2d-4d4f-9d39-8f5b117f2d5d",
      "headSha": "74e07982ef2312987c024715d41a631afdb4fdcc",
      "confidence": "confirmed",
      "severity": "medium",
      "category": "production-safety",
      "file": "src/workflows/work-on.ts",
      "line": 3863,
      "summary": "Merged pull requests can be left labeled awaiting-merge when durable merge evidence is missing.",
      "evidence": [
        "The new #projectWorkflowStage(link, \"awaitingMerge\", ...) call executes before the currentPull.merged && !durableMergeSha consistency check.",
        "That check then throws when a merged PR has no durable merge SHA, but this path has no compensating label rollback, so the issue projection remains workflow:awaiting-merge despite the PR already being merged."
      ]
    }
  ],
