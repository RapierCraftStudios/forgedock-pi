{
  "schema": "forgedock.config/v1",
  "repository": {
    "provider": "github",
    "name": "RapierCraftStudios/forgedock-pi"
  },
  "state": {
    "branch": "forgedock/state/v1",
    "leaseSeconds": 3600,
    "heartbeatSeconds": 60
  },
  "branches": {
    "integration": [
      "dogfood"
    ],
    "protected": [
      "main"
    ],
    "autoMergeIntegration": true
  },
  "verification": {
    "github": {
      "required": true,
      "requiredBranches": [
        "dogfood"
      ],
      "waitTimeoutMs": 1800000,
      "pollIntervalMs": 10000
    },
    "commands": {}
  },
  "review": {
    "required": [
      "forge-review-correctness",
      "forge-review-security"
    ],
    "maxRounds": 2
  },
  "orchestration": {
    "maxConcurrent": 20,
    "maxIssues": 20
  },
  "subagents": {
    "maxConcurrent": 20,
    "maxDepth": 2,
    "workOnTimeoutMs": 14400000,
    "reviewerTimeoutMs": 3600000
  }
}
